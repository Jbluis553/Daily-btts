# Copia a .env y rellena tu clave. Documentación: https://docs.thestatsapi.com
THESTATSAPI_KEY=tu_api_key_aqui
DATE_FROM=
DATE_TO=
MIN_PCT=80
TOP_N=20
MIN_EDGE=0
BANKROLL=100
MODEL_WEIGHTS=historical:0.15,bivariate_poisson:0.25,lstm_momentum:0.15,xgboost:0.25,catboost:0.20
MAX_RPM=1000
HISTORY_WORKERS=20
# TRAIN_MODELS=1            # entrena XGB/CatBoost/LSTM con los datos reales del día
# INJURIES_ENDPOINT=/football/teams/{team_id}/injuries
# ODDS_ENDPOINT=/football/matches/{match_id}/odds
LOG_LEVEL=INFO
